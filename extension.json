{
	"name": "NavigationForPagesAsRooms",
	"author": "Rob Nugen",
	"url": "https://github.com/thunderrabbit/NavigationForPagesAsRooms",
	"description": "Renders <navigation/> tags as room-specific exit links for the Castle of Dreams wiki.",
	"version": "2.1.0",
	"license-name": "GPL-3.0-or-later",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.39.0"
	},
	"manifest_version": 2,
	"AutoloadClasses": {
		"NavigationForPagesAsRooms": "NavigationForPagesAsRooms.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\NavigationForPagesAsRooms\\": "includes/"
	},
	"SpecialPages": {
		"CastleNavigation": "MediaWiki\\Extension\\NavigationForPagesAsRooms\\SpecialCastleNavigation"
	},
	"MessagesDirs": {
		"NavigationForPagesAsRooms": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"NavigationForPagesAsRoomsAlias": "NavigationForPagesAsRooms.alias.php"
	},
	"TrackingCategories": [
		"nfpar-tracking-category-no-entry"
	],
	"descriptionmsg": "castlenavigation-desc",
	"Hooks": {
		"ParserFirstCallInit": "NavigationForPagesAsRooms::onParserFirstCallInit"
	}
}
